{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"],
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/.bun/electron@44.1.1/node_modules/@types"
    ],
    "paths": {
      "@impresora-pos/contracts": ["../../packages/contracts/src/index.ts"],
      "@impresora-pos/printer-core/*": ["../../packages/printer-core/*"],
      "@impresora-pos/templates": ["../../packages/templates/src/index.ts"],
      "@impresora-pos/renderer": ["../../packages/renderer/src/index.ts"]
    },
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["electron/**/*.test.ts", "e2e/**/*.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
